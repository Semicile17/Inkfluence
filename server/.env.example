# ── Core ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Allowed browser origin(s), comma-separated. On Vercel set this to your
# deployed client URL, e.g. https://inkfluence.vercel.app
CLIENT_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────
# Leave empty in development to use a zero-config in-memory MongoDB.
# For persistent data, use a local MongoDB or a free Atlas cluster:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/inkfluence
MONGODB_URI=

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Free AI (optional, but recommended) ──────────────
# Muse always works via a local matching fallback. Add ONE free key for
# full AI-written recommendations:
# Google AI Studio (free tier): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Or Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Keyless free AI endpoint used out of the box when no key is set.
# Anonymous use is rate-limited; the server falls back to local matching.
POLLINATIONS_ENABLED=true
POLLINATIONS_MODEL=openai

# Seed demo content automatically when the database is empty
AUTO_SEED=true

# On Vercel, set AUTO_SEED=false and MONGOMS_DISABLE_POSTINSTALL=1. The API
# connects lazily and reuses the Atlas connection across warm invocations.
